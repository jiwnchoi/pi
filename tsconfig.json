{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/extensions/**/*.ts",
    "packages/*/lib/**/*.ts",
    "packages/*/runner/**/*.ts",
    "packages/*/test/**/*.ts"
  ],
  "exclude": ["**/dist", "**/node_modules"]
}
